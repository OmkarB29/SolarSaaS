# ==============================================================================
# SolarSaaS / SolarScope Environment Variables Template
# ==============================================================================
# Copy this file to .env and configure the secrets for your local environment.
# IMPORTANT SECURITY RULES:
# 1. Never commit .env with real secrets to version control.
# 2. Browser keys must be restricted by HTTP referrer in Google Cloud Console.
# 3. Server keys must NEVER be exposed to Vite (do NOT prefix with VITE_).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND / CLIENT-SIDE VARIABLES (Browser Exposed via Vite)
# ------------------------------------------------------------------------------
# Google Maps Browser Key:
# Used by Maps JavaScript API (photorealistic 3D maps, geocoding, places).
# Must be restricted in Google Cloud Console to HTTP referrers:
#   - http://localhost:5173/*
#   - http://localhost:3000/*
#   - https://your-production-domain.com/*
# Obtain at: https://console.cloud.google.com/google/maps-apis/credentials
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Backend API Base URL (defaults to http://localhost:8081 if omitted)
VITE_API_URL=http://localhost:8081

# ------------------------------------------------------------------------------
# 2. BACKEND / SERVER-SIDE VARIABLES (Java 21 Spring Boot)
# ------------------------------------------------------------------------------
# Meshy AI V1 Flagship API Key:
# Used for Image-to-3D GLB mesh generation.
# Keep this secret; never expose to frontend.
# Obtain at: https://www.meshy.ai/ (Account Settings -> API Keys)
MESHY_API_KEY=

# Mock Mode Guard:
# When true (DEFAULT for local development), the backend generates 3D models using
# the bundled box-building GLB with zero credit consumption and simulated progress.
# Set to 'false' only when you have a funded Meshy API key and wish to consume live credits.
MESHY_MOCK_ENABLED=true

# Meshy Pipeline Tunables (Defaults provided below):
MESHY_BASE_URL=https://api.meshy.ai/openapi/v1
MESHY_AI_MODEL=meshy-7.1
MESHY_TOPOLOGY=triangle
MESHY_TARGET_POLYCOUNT=60000
MESHY_SHOULD_REMESH=true
MESHY_SHOULD_TEXTURE=true
MESHY_ENABLE_PBR=false
MESHY_IMAGE_ENHANCEMENT=false
MESHY_POLLING_INTERVAL_SECONDS=5
MESHY_MAX_JOBS_PER_USER_PER_DAY=10
MESHY_MAX_GLOBAL_JOBS_PER_DAY=50

# Google Maps Server Key:
# Used on the backend for Google Solar API proxies and Google Static Maps captures.
# Must be restricted by IP address (or unrestricted on secure backend host).
# Obtain at: https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_SOLAR_API_KEY=

# Legal Compliance Safeguard for Google Satellite Imagery:
# Google Maps Platform Terms of Service (Section 3.2.3 & 3.2.4) prohibits extracting
# or creating derivative 3D AI meshes from Google Maps imagery without an enterprise license.
# By default, this is disabled (false). When false, the pipeline relies on user-supplied
# aerial/drone imagery (UploadedImageProvider).
ROOFTOP_IMAGERY_GOOGLE_STATIC_ENABLED=false

# Local Storage Directory for Generated GLB Meshes:
# Meshy signed URLs expire in 72 hours (3 days) on standard plans.
# The backend immediately downloads and persists GLBs locally in this directory.
ROOFTOP_STORAGE_GLB_DIR=uploads/models3d

# OpenAI API Key (for LLM solar analysis insights and advisory)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (PostgreSQL in production; H2 in-memory in test)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/solarsaas
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
